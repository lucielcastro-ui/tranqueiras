  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: DesignSystem.grey50,
      body: BlocListener<TaskBloc, TaskState>(
        listener: (context, state) async {
          if (ModalRoute.of(context)?.isCurrent != true) return;
          String? prioritizeSubTaskIdForSync;
          // Evita snack genérico ao falhar criação (já há feedback no diálogo).
          if (state is TaskError &&
              state.tasks.isNotEmpty &&
              state.failure is NetworkFailure) {
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('Falha ao sincronizar tarefas.')),
            );
          }
          if (state is TaskError && _pendingScheduleExecutionTaskId != null) {
            setState(() {
              _pendingScheduleExecutionTaskId = null;
              _pendingScheduleExecutionNormHorario = null;
            });
          }
          if (state is TaskError && _pendingDirectExecutionTaskId != null) {
            setState(() {
              _pendingDirectExecutionTaskId = null;
            });
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('Falha ao executar tarefa.')),
            );
          }
          if (state is TaskLoaded && _pendingScheduleExecutionTaskId != null) {
            prioritizeSubTaskIdForSync = _pendingScheduleExecutionTaskId;
            final tid = _pendingScheduleExecutionTaskId!;
            final normH = _pendingScheduleExecutionNormHorario;
            TaskEntity? execTask;
            for (final t in state.tasks) {
              if (t.taskId == tid) {
                execTask = t;
                break;
              }
            }
            setState(() {
              if (execTask != null &&
                  execTask.schedules.isNotEmpty &&
                  normH != null &&
                  normH.isNotEmpty) {
                final prev = _taskExecutionProgress[tid];
                final prevPool = (prev?['realizados'] as List?)
                        ?.map((e) => e.toString())
                        .toList() ??
                    <String>[];
                final nextPool = [...prevPool, normH];
                final limit = _executionLimitForTask(execTask);
                final indices = scheduleIndicesFromNormalizedRealizadosPool(
                  execTask,
                  nextPool,
                );
                var done = indices.length;
                if (done > limit) done = limit;
                _taskExecutionProgress[tid] = {
                  'done': done,
                  'limit': limit,
                  'realizados': nextPool,
                };
              }
              _pendingScheduleExecutionTaskId = null;
              _pendingScheduleExecutionNormHorario = null;
            });
            await _saveTaskExecutionProgress();
            if (!context.mounted) return;
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('Horário realizado com sucesso.')),
            );
          }
          if (state is TaskLoaded && _pendingDirectExecutionTaskId != null) {
            final taskId = _pendingDirectExecutionTaskId!;
            final previous = _taskExecutionProgress[taskId];
            final task = state.tasks.cast<TaskEntity?>().firstWhere(
                  (item) => item?.taskId == taskId,
                  orElse: () => null,
                );
            final fallbackLimit =
                task != null ? _executionLimitForTask(task) : 1;
            final limit = previous?['limit'] ?? fallbackLimit;
            // Execução direta (sem horário): ao sucesso fecha imediatamente.
            final normalizedDone = limit;
            final prevRz = _taskExecutionProgress[taskId]?['realizados'];
            setState(() {
              _taskExecutionProgress[taskId] = {
                'done': normalizedDone,
                'limit': limit,
                if (prevRz is List) 'realizados': prevRz,
              };
              _pendingDirectExecutionTaskId = null;
            });
            _saveTaskExecutionProgress();
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('Tarefa executada com sucesso.')),
            );
          }
          if (state is TaskCacheLoaded && state.tasks.isNotEmpty) {
            if (!mounted || _taskInteractionOpen) return;
            _applyBackendStatusToProgress(state.tasks);
          }
          // Só sincroniza após a lista remota — evita POST em lote duplicado
          // (TaskCacheLoaded + TaskLoaded) que competia com o GET do chat (429).
          if (state is TaskLoaded && state.tasks.isNotEmpty) {
            await _pruneExecutionCaches(state.tasks);
            if (!mounted || _taskInteractionOpen) return;
            _applyBackendStatusToProgress(state.tasks);
            await _syncExecutionProgressForTasks(
              state.tasks,
              prioritizeSubTaskId: prioritizeSubTaskIdForSync,
            );
          }
        },
        child: BlocBuilder<TaskBloc, TaskState>(
          builder: (context, state) {
            final rawTasks = state.tasks;
            final openCount =
                rawTasks.where((task) => _isTaskOpen(task)).length;
            final closedCount =
                rawTasks.where((task) => !_isTaskOpen(task)).length;
            final statusCountLabel = _filterType == TaskFilterType.all
                ? (_showOpenTasks
                    ? '$openCount abertas'
                    : '$closedCount fechadas')
                : '${rawTasks.length} tarefas';

            Widget content;
            if (state is TaskLoading && state.tasks.isEmpty) {
              content = const Center(child: CircularProgressIndicator());
            } else if (state is TaskError && state.tasks.isEmpty) {
              content = Center(
                child: Padding(
                  padding: const EdgeInsets.all(16),
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      const Icon(
                        Icons.error_outline,
                        color: DesignSystem.error,
                        size: 36,
                      ),
                      const SizedBox(height: 10),
                      Text(
                        'Não foi possível carregar tarefas.',
                        textAlign: TextAlign.center,
                        style: Theme.of(context).textTheme.bodyMedium,
                      ),
                      const SizedBox(height: 12),
                      OutlinedButton.icon(
                        onPressed: _loadTasks,
                        icon: const Icon(Icons.refresh),
                        label: const Text('Tentar novamente'),
                      ),
                    ],
                  ),
                ),
              );
            } else {
              final tasks = _filterType == TaskFilterType.all
                  ? rawTasks
                      .where((task) => _showOpenTasks
                          ? _isTaskOpen(task)
                          : !_isTaskOpen(task))
                      .toList()
                  : rawTasks;
              if (tasks.isEmpty) {
                content = Center(
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    children: [
                      Icon(
                        Icons.assignment_outlined,
                        color: DesignSystem.grey300,
                        size: 48,
                      ),
                      const SizedBox(height: DesignSystem.spacingS),
                      const Text(
                        'Nenhuma tarefa encontrada',
                        style: TextStyle(
                          fontSize: 15,
                          fontWeight: FontWeight.w600,
                          fontFamily: DesignSystem.fontFamily,
                          color: DesignSystem.grey800,
                        ),
                      ),
                      const SizedBox(height: 4),
                      const Text(
                        'Ajuste os filtros ou crie uma nova tarefa',
                        style: TextStyle(
                          fontSize: 12,
                          fontFamily: DesignSystem.fontFamily,
                          color: DesignSystem.grey600,
                        ),
                      ),
                    ],
                  ),
                );
              } else {
                content = RefreshIndicator(
                  onRefresh: () async => _loadTasks(),
                  child: ListView.separated(
                    padding: const EdgeInsets.fromLTRB(16, 12, 16, 24),
                    physics: const AlwaysScrollableScrollPhysics(),
                    itemCount: tasks.length,
                    separatorBuilder: (_, __) => const SizedBox(height: 12),
                    itemBuilder: (_, index) {
                      final task = tasks[index];
                      return TaskCard(
                        task: task,
                        isOpenInList: _isTaskOpen(task),
                        executionStatusLabel:
                            _executionStatusLabelForTask(task),
                        realizedScheduleIndices:
                            _realizedScheduleIndicesForTask(task),
                        isExpanded: _expandedCards[task.taskId] ?? false,
                        isExecuteLoading:
                            _pendingDirectExecutionTaskId == task.taskId,
                        onExpandToggle: () => setState(() {
                          _expandedCards[task.taskId] =
                              !(_expandedCards[task.taskId] ?? false);
                        }),
                        onOpenInteraction: () => _openTaskInteraction(task),
                        onExecute: () => _executeTask(task),
                        onScheduleTap: (schedule) =>
                            _registerTaskScheduleExecution(task, schedule),
                      );
                    },
                  ),
                );
              }
            }

            return Column(
              children: [
                MainTabHeader.withCreate(
                  title: 'Tarefas',
                  backgroundColor: Colors.transparent,
                  onCreate: _showCreateTaskDialog,
                  // showBottomBorder: true,
                ),
                if (state is! TaskLoading || state.tasks.isNotEmpty)
                  _buildTaskSummaryMetrics(
                    total: rawTasks.length,
                    openCount: openCount,
                    closedCount: closedCount,
                  ),
                TaskFilterHeader(
                  isDateSelected: _filterType == TaskFilterType.date,
                  showOpenStatus: _showOpenTasks,
                  selectedDate: _selectedDate,
                  onSelectGroup: () {
                    if (_filterType == TaskFilterType.all) return;
                    setState(() {
                      _filterType = TaskFilterType.all;
                      _showOpenTasks = true;
                    });
                    _loadTasks();
                  },
                  onSelectDate: () {
                    if (_filterType == TaskFilterType.date) return;
                    setState(() {
                      _filterType = TaskFilterType.date;
                    });
                    _loadTasks();
                  },
                  onPreviousDate: () => setState(() {
                    _selectedDate = _selectedDate.add(const Duration(days: -1));
                    _loadTasks();
                  }),
                  onNextDate: () => setState(() {
                    _selectedDate = _selectedDate.add(const Duration(days: 1));
                    _loadTasks();
                  }),
                  onSelectOpenStatus: () {
                    if (_showOpenTasks) return;
                    setState(() {
                      _showOpenTasks = true;
                    });
                  },
                  onSelectClosedStatus: () {
                    if (!_showOpenTasks) return;
                    setState(() {
                      _showOpenTasks = false;
                    });
                  },
                ),
                // Container(
                //   width: double.infinity,
                //   padding: const EdgeInsets.fromLTRB(16, 10, 16, 10),
                //   decoration: const BoxDecoration(
                //     color: Colors.white,
                //     border: Border(
                //       bottom: BorderSide(color: DesignSystem.grey200),
                //     ),
                //   ),
                //   child: Row(
                //     children: [
                //       Expanded(
                //         child: Text(
                //           _filterType == TaskFilterType.all
                //               ? 'Visualização: ${_showOpenTasks ? 'Abertas' : 'Fechadas'}'
                //               : 'Visualização: Data',
                //           style: const TextStyle(
                //             fontSize: 12,
                //             color: DesignSystem.grey600,
                //             fontWeight: FontWeight.w600,
                //           ),
                //         ),
                //       ),
                //       Container(
                //         padding: const EdgeInsets.symmetric(
                //             horizontal: 10, vertical: 4),
                //         decoration: BoxDecoration(
                //           color:
                //               DesignSystem.primaryGreen.withValues(alpha: 0.12),
                //           borderRadius: BorderRadius.circular(14),
                //         ),
                //         child: Text(
                //           statusCountLabel,
                //           style: const TextStyle(
                //             fontSize: 12,
                //             fontWeight: FontWeight.bold,
                //             color: DesignSystem.grey800,
                //           ),
                //         ),
                //       ),
                //     ],
                //   ),
                // ),
                Expanded(child: content),
              ],
            );
          },
        ),
      ),
    );
  }
}

class _TaskExecutionProgress {
  final int done;
  final int limit;
  final bool isOpen;

  const _TaskExecutionProgress({
    required this.done,
    required this.limit,
    required this.isOpen,
  });

  bool get isClosed => !isOpen;
}
