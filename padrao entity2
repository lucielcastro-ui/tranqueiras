import 'package:equatable/equatable.dart';

class TarefaGrupoEntity extends Equatable {
  final int idGrupoTarefa;
  final String nome;

   const TarefaGrupoEntity({
    required this.idGrupoTarefa,
    required this.nome,
  });

  TarefaGrupoEntity copyWith({
    int? idGrupoTarefa,
    String? nome,
  }) {
    return TarefaGrupoEntity(
      idGrupoTarefa: idGrupoTarefa ?? this.idGrupoTarefa,
      nome: nome ?? this.nome,
    );
  }

  @override
  String toString() =>
      'TarefaGrupoEntity(idGrupoTarefa: $idGrupoTarefa, nome: $nome)';
  @override
  List<Object?> get props => [idGrupoTarefa, nome];
}
