import 'dart:convert';
import 'package:intl/intl.dart';

class Atendimento {
  final int idSuporte;
  final DateTime dataAtendimento;
  final String descricao;
  final String nomeUsuario;
  final String tipoUsuario;
  final String nivelUsuario;

  Atendimento({
    required this.idSuporte,
    required this.dataAtendimento,
    required this.descricao,
    required this.nomeUsuario,
    required this.tipoUsuario,
    required this.nivelUsuario,
  });

  Map<String, dynamic> toMap() {
    return <String, dynamic>{
      'id_suporte': idSuporte,
      'atendimento_created_at': dataAtendimento.millisecondsSinceEpoch,
      'descricao': descricao,
      'nome_usuario': nomeUsuario,
      'tipo_usuario': tipoUsuario,
      'nivel_usuario': nivelUsuario,
    };
  }

  factory Atendimento.fromMap(Map<String, dynamic> map) {
    return Atendimento(
      idSuporte: map['id_suporte'] ?? 0,
      dataAtendimento: DateFormat('yyyy-MM-dd HH:mm:ss')
          .parse(map['atendimento_created_at']),
      descricao: map['descricao'] as String,
      nomeUsuario: map['nome_usuario'] != null
          ? map['nome_usuario'] as String
          : "Nome não informado",
      tipoUsuario: map['tipo_usuario'] != null
          ? map['tipo_usuario'] as String
          : "Tipo não informado",
      nivelUsuario: map['nivel_usuario'] != null
          ? map['nivel_usuario'] as String
          : "Nível não informado",
    );
  }

  String toJson() => json.encode(toMap());

  factory Atendimento.fromJson(String source) =>
      Atendimento.fromMap(json.decode(source) as Map<String, dynamic>);

  @override
  String toString() {
    return 'Atendimento(id_suporte: $idSuporte, atendimento_created_at: $dataAtendimento, descricao: $descricao, nome_usuario: $nomeUsuario, tipo_usuario: $tipoUsuario, nivel_usuario: $nivelUsuario)';
  }
}
