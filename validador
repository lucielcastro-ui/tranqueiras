class Validadores {
  static String? isEmpty(String value) {
    if (value.isEmpty) {
      return '';
    }
    return null;
  }

  static String? isValidDate(String? value) {
    if (!RegExp(r'^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/((20[0-9]{2})|2100)$').hasMatch(value ?? '')) {
      return 'Insira uma data válida.';
    }
    return null;
  }
}
